{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "flowbit",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "category": "Video",
    "shortDescription": "Streaming torrent client",
    "longDescription": "Watch torrents while they download, keep track of what you've watched, and translate subtitles. English and Arabic.",
    "resources": [],
    "linux": {
      "deb": {
        "depends": ["mpv", "xdg-utils"],
        "section": "net"
      },
      "rpm": {
        "depends": ["mpv", "xdg-utils"]
      }
    }
  }
}
