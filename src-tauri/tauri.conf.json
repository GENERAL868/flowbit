{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowbit",
  "mainBinaryName": "Flowbit",
  "version": "1.3.1",
  "identifier": "app.flowbit.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flowbit",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "create": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0B0E13",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Flowbit",
    "copyright": "Flowbit contributors. mpv is GPLv2+ (https://mpv.io).",
    "shortDescription": "Streaming torrent client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/mpv/mpv.exe",
      "resources/mpv/portable_config/mpv.conf",
      "resources/mpv/portable_config/fonts.conf",
      "resources/torrent-file.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
